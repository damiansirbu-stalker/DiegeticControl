--- dc_diegetic: Volume/frequency control for in-world radios, megaphones, guitar, harmonica

local math_random, tonumber, tostring = math.random, tonumber, tostring
local sound_object, RegisterScriptCallback = sound_object, RegisterScriptCallback

local log = xlog.get_logger("DC", { outfile = "diegeticcontrol.log" })

local CAT_RADIO = "radio"
local CAT_MEGAPHONE = "megaphone"

local snap = {
    master = 1.0, debug = false,
    radio_on = true, radio_vol = 1.0, radio_freq = 1.0,
    mega_on = true, mega_vol = 1.0, mega_freq = 1.0,
    guitar_on = true, guitar_vol = 1.0,
    harmonica_on = true, harmonica_vol = 1.0,
}

--- Update the config snapshot from MCM.
local function update_snapshot()
    local getter = dc_mcm and dc_mcm.get_config
    local function get(key, default)
        local v = getter and getter(key)
        if v == nil then return default end
        return v
    end
    snap.master        = get("master_volume", 1.0)
    snap.debug         = get("debug_mode", false)
    snap.radio_on      = get("radio_enabled", true)
    snap.radio_vol     = get("radio_volume", 1.0)
    snap.radio_freq    = get("radio_frequency", 1.0)
    snap.mega_on       = get("megaphone_enabled", true)
    snap.mega_vol      = get("megaphone_volume", 1.0)
    snap.mega_freq     = get("megaphone_frequency", 1.0)
    snap.guitar_on     = get("guitar_enabled", true)
    snap.guitar_vol    = get("guitar_volume", 1.0)
    snap.harmonica_on  = get("harmonica_enabled", true)
    snap.harmonica_vol = get("harmonica_volume", 1.0)
end

--- True when the theme is a radio emitter.
local function is_radio(theme)
    return theme:find("radio") or theme:find("sidor") or theme:find("forester") or theme:find("bar_")
        or theme:find("stalker_base") or theme:find("yantar") or theme:find("monolith")
        or theme:find("hangar") or theme:find("cit_mers") or theme:find("val_free")
        or theme:find("clear_sky") or theme:find("bandit")
end

--- True when the theme is a megaphone emitter.
local function is_megaphone(theme)
    return theme:find("megafon") or theme:find("megaphone") or theme:find("rupor")
        or theme:find("arena_") or theme:find("propaganda") or theme:find("alarm") or theme:find("announce")
end

--- Classify a ph_sound emitter by theme: radio / megaphone / other.
local function get_theme_category(theme_name)
    if not theme_name then return "other" end
    local theme = theme_name:lower()
    if is_radio(theme) then return CAT_RADIO end
    if is_megaphone(theme) then return CAT_MEGAPHONE end
    return "other"
end

--- (volume mult, frequency mult) for a category; disabled = 0 volume.
local function get_settings(cat)
    if cat == CAT_RADIO then
        return (snap.radio_on and snap.master * snap.radio_vol or 0), snap.radio_freq
    elseif cat == CAT_MEGAPHONE then
        return (snap.mega_on and snap.master * snap.mega_vol or 0), snap.mega_freq
    end
    return snap.master, 1.0
end

local orig_snd_update = nil

--- Wrap ph_sound.snd_source.update: apply frequency, then set volume from the condlist base.
local function update_snd_source(self, delta)
    local st = self.st
    local cat = st._dc_cat
    if cat == nil then
        cat = get_theme_category(st.theme)
        st._dc_cat = cat
        if snap.debug then log.debug("source theme=%s cat=%s", tostring(st.theme), cat) end
    end
    local vol_mult, freq_mult = get_settings(cat)

    if freq_mult ~= 1.0 or st._dc_pmin ~= nil then
        if st._dc_pmin == nil then
            st._dc_pmin = st.pause_min
            st._dc_pmax = st.pause_max
        end
        st.pause_min = st._dc_pmin * freq_mult
        st.pause_max = st._dc_pmax * freq_mult
    end

    orig_snd_update(self, delta)

    if vol_mult ~= 1.0 and self.played_sound and self.played_sound:playing() then
        local base = 1.0
        if st.volume then
            local picked = xr_logic.pick_section_from_condlist(db.actor, self.object, st.volume)
            if picked and picked ~= "" then base = tonumber(picked) or 1.0 end
        end
        self.played_sound.volume = base * vol_mult
        if snap.debug then log.debug("%s '%s' base=%.2f mult=%.2f -> %.2f", cat, tostring(st.theme), base, vol_mult, base * vol_mult) end
    end
end

local INSTR = {
    guitar = {
        mod = nil, tracks = 28, path = "music\\guitar_",
        motion_item = "item_guit_anm_1_hud", motion_show = "anm_guitar_show", show_speed = 1,
        on = function() return snap.guitar_on end, vol = function() return snap.guitar_vol end,
    },
    harmonica = {
        mod = nil, tracks = 5, path = "music\\harmonica_",
        motion_item = "item_harm_anm_1_hud", motion_show = "anm_harmonica_show", show_speed = 0.45,
        on = function() return snap.harmonica_on end, vol = function() return snap.harmonica_vol end,
    },
}

--- Play one instrument at the configured volume, or restore when disabled.
local function play_instrument(name)
    local instr = INSTR[name]
    local mod = instr.mod
    if not instr.on() then
        if mod.restore then mod.restore() end
        return
    end

    level.disable_input()
    local snd = sound_object(instr.path .. math_random(instr.tracks))
    local len = snd:length() / 1000
    snd:play_no_feedback(db.actor, 0, 0, db.actor:position(), snap.master * instr.vol(), 1.0)
    game.play_hud_motion(2, instr.motion_item, instr.motion_show, false, instr.show_speed)

    CreateTimeEvent(name .. "_holster_a", name .. "_holster_v", len, function()
        if mod.can_play_anim() then
            mod.holster_guitar()
            return true
        end
        return false
    end)
end

--- Wrap ph_sound.snd_source.update and replace the instrument play functions.
local function apply_hooks()
    local snd_source = ph_sound and ph_sound.snd_source
    if snd_source and snd_source.update then
        orig_snd_update = snd_source.update
        snd_source.update = update_snd_source
        if snap.debug then log.debug("hooked ph_sound.snd_source.update (radio/megaphone)") end
    else
        log.warn("ph_sound absent - radio/megaphone control off")
    end

    if guitar_anim and guitar_anim.play_guitar then
        INSTR.guitar.mod = guitar_anim
        guitar_anim.play_guitar = function() play_instrument("guitar") end
    end
    if harmonica_anim and harmonica_anim.play_harmonica then
        INSTR.harmonica.mod = harmonica_anim
        harmonica_anim.play_harmonica = function() play_instrument("harmonica") end
    end
end

function on_game_start()
    update_snapshot()
    log.info("DiegeticControl v%s (xlibs v%s)", _dc_init.get_version(), xlibs.get_version())
    apply_hooks()
    RegisterScriptCallback("actor_on_first_update",      update_snapshot)
    RegisterScriptCallback("on_option_change",           update_snapshot)
    RegisterScriptCallback("mcm_option_restore_default", update_snapshot)
end
