--- dc_mcm: MCM configuration for DiegeticControl

local RegisterScriptCallback = RegisterScriptCallback

defaults = {
    master_volume = 1.0,
    radio_volume = 1.0,
    radio_frequency = 1.0,
    megaphone_volume = 1.0,
    megaphone_frequency = 1.0,
    guitar_volume = 1.0,
    harmonica_volume = 1.0,
    radio_enabled = true,
    megaphone_enabled = true,
    guitar_enabled = true,
    harmonica_enabled = true,
    debug_mode = false,
}

local _key_to_tab = {
    debug_mode = "development",
    btn_reset_all = "development",
    btn_update_check = "development",
}

local function build_path(key)
    return "dc/" .. (_key_to_tab[key] or "general") .. "/" .. key
end

cfg, get_config, load_config = xmcm.create_config("dc", defaults, build_path)

-- Write every default back through MCM config, then close the dialog safely.
-- @src ui_mcm.script:1435: functor_ui passes the UI_MCM instance (plain functor gets nothing), needed as get_gui() is nil on fresh opens (MCM 1.7.2fix).
-- @src ui_mcm.script:949: close via On_Cancel not On_Discard; On_Discard's scroll_opt:Clear frees btn_reset_all mid-click and SEH-fires on some exes.
-- @src ui_mcm.script:175,2393: On_Accept writes opt_temp after our writes, so widget edits touched before reset re-apply.
local function _apply_defaults(gui, msg)
    local config = axr_main.config
    for k, v in pairs(defaults) do
        config:w_value("mcm", build_path(k), v)
    end
    config:save()
    load_config()
    if gui then
        if gui.owner and gui.owner.SetMsg then
            gui.owner:SetMsg(msg, 5)
        end
        if gui.On_Cancel then
            gui:On_Cancel()
        end
    end
    if db.actor then
        news_manager.send_tip(db.actor, msg, nil, nil, 5000)
    end
end

function btn_reset_all(gui)
    _apply_defaults(gui, game.translate_string("st_dc_reset_all_done"))
end

function on_mcm_load()
    return {
        id = "dc",
        gr = {
          {
            id = "general",
            sh = true,
            gr = {
            {id = "title", type = "slide", link = "dc_mcm_banner",
             text = "ui_mcm_dc_title", size = {512, 50}, spacing = 20},

            {id = "divider_master", type = "line"},
            {id = "desc_master", type = "desc",
             text = "ui_mcm_dc_desc_master", clr = {255, 200, 200, 100}},
            {id = "master_volume", type = "track",
             val = 2, min = 0.1, max = 3.0, step = 0.1, def = 1.0},

            {id = "divider_radio", type = "line"},
            {id = "desc_radio", type = "desc",
             text = "ui_mcm_dc_desc_radio", clr = {255, 100, 200, 255}},
            {id = "radio_enabled", type = "check", val = 1, def = true},
            {id = "radio_volume", type = "track",
             val = 2, min = 0.1, max = 5.0, step = 0.1, def = 1.0},
            {id = "radio_frequency", type = "track",
             val = 2, min = 0.25, max = 4.0, step = 0.25, def = 1.0},

            {id = "divider_megaphone", type = "line"},
            {id = "desc_megaphone", type = "desc",
             text = "ui_mcm_dc_desc_megaphone", clr = {255, 100, 200, 255}},
            {id = "megaphone_enabled", type = "check", val = 1, def = true},
            {id = "megaphone_volume", type = "track",
             val = 2, min = 0.1, max = 5.0, step = 0.1, def = 1.0},
            {id = "megaphone_frequency", type = "track",
             val = 2, min = 0.25, max = 4.0, step = 0.25, def = 1.0},

            {id = "divider_guitar", type = "line"},
            {id = "desc_guitar", type = "desc",
             text = "ui_mcm_dc_desc_guitar", clr = {255, 100, 200, 255}},
            {id = "guitar_enabled", type = "check", val = 1, def = true},
            {id = "guitar_volume", type = "track",
             val = 2, min = 0.1, max = 3.0, step = 0.1, def = 1.0},

            {id = "divider_harmonica", type = "line"},
            {id = "desc_harmonica", type = "desc",
             text = "ui_mcm_dc_desc_harmonica", clr = {255, 100, 200, 255}},
            {id = "harmonica_enabled", type = "check", val = 1, def = true},
            {id = "harmonica_volume", type = "track",
             val = 2, min = 0.1, max = 3.0, step = 0.1, def = 1.0},

            {id = "div_version", type = "line"},
            {id = "version", type = "desc", text = "ui_mcm_dc_title",
                ui_hook_functor = { _dc_init.get_platform_functor() },
                clr = {255, 212, 201, 168}},
            },
          },
          {
            id = "development",
            sh = true,
            gr = {
            {id = "title", type = "slide", link = "dc_mcm_banner",
             text = "ui_mcm_dc_title", size = {512, 50}, spacing = 20},
            {id = "desc", type = "desc", text = "ui_mcm_dc_development_desc"},

            {id = "divider_debug", type = "line"},
            {id = "debug_mode", type = "check", val = 1, def = false},

            {id = "div_reset", type = "line"},
            {id = "warn_reset", type = "desc", text = "ui_mcm_dc_development_reset_warning", clr = {255, 240, 200, 80}},
            {id = "btn_reset_all", type = "button", functor_ui = { btn_reset_all }},
            {id = "btn_update_check", type = "button", functor_ui = { _dc_init.show_update_check }},
            },
          },
        },
    }
end

function on_game_start()
    load_config()
    RegisterScriptCallback("on_option_change", load_config)
    RegisterScriptCallback("mcm_option_restore_default", load_config)
end
